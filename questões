// Questao 2 calcula imc
function calcular_imc(peso, altura) {
  var imc_bruto = peso / (altura * altura);
  var imc_final = Math.round(imc_bruto * 100) / 100;
  var classificacao = "";

  if (imc_final < 18.5) {
    classificacao = "Abaixo do peso";
  } else if (imc_final >= 18.5 && imc_final <= 24.9) {
    classificacao = "Peso normal";
  } else if (imc_final >= 25.0 && imc_final <= 29.9) {
    classificacao = "Sobrepeso";
  } else if (imc_final >= 30.0 && imc_final <= 34.9) {
    classificacao = "Obesidade Grau I";
  } else if (imc_final >= 35.0 && imc_final <= 39.9) {
    classificacao = "Obesidade Grau II";
  } else {
    classificacao = "Obesidade Grau III";
  }

  return {
    imc: imc_final,
    classificacao: classificacao
  };
}
