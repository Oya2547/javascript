// Questao 1contador de tempo
function calcular_contagem_regressiva(data_futura) {
  var agora = new Date();

  var futuro = new Date(data_futura);

  var diferenca = futuro.getTime() - agora.getTime();

  var total_segundos = Math.floor(diferenca / 1000);

  var dias = Math.floor(total_segundos / (24 * 3600));

  var resto_dias = total_segundos % (24 * 3600);

  var horas = Math.floor(resto_dias / 3600);

  var resto_horas = resto_dias % 3600;

  var minutos = Math.floor(resto_horas / 60);

  var segundos = resto_horas % 60;

  var texto_formatado = "Faltam " + dias + " dias, " + horas + "h, " + minutos + "m e " + segundos + "s";

  return {
    dias: dias,
    horas: horas,
    minutos: minutos,
    segundos: segundos,
    texto: texto_formatado
  };
}
