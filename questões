// Questao 4 valida usuario
function validar_usuario(usuario) {
  var erros = [];

  // checa nome
  if (usuario.nome.length < 3) {
    erros.push("Nome deve ter pelo menos 3 caracteres");
  }

  // checa email
  var tem_arroba = false;
  var tem_ponto = false;

  if (usuario.email.includes("@")) {
    tem_arroba = true;
  }
  if (usuario.email.includes(".")) {
    tem_ponto = true;
  }

  if (tem_arroba == false || tem_ponto == false) {
    erros.push("E-mail inválido");
  }

  // checa senha
  var tem_numero = false;
  var numeros = "0123456789";

  for (var i = 0; i < usuario.senha.length; i++) {
    if (numeros.includes(usuario.senha[i])) {
      tem_numero = true;
    }
  }

  if (usuario.senha.length < 6 || tem_numero == false) {
    erros.push("Senha deve ter pelo menos 6 caracteres");
  }

  if (erros.length > 0) {
    return {
      valido: false,
      erros: erros
    };
  } else {
    return {
      valido: true
    };
  }
}

