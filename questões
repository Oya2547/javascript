// Questao 3 tabuada
function gerar_tabuada(numero, limite) {
  if (limite == undefined) {
    limite = 10;
  }

  var tabuada = [];

  for (var i = 1; i <= limite; i++) {
    var resultado = numero * i;
    tabuada.push(numero + " x " + i + " = " + resultado);
  }

  return tabuada;
}
