// Questao 5 estatistica de array
function analisar_numeros(array_de_numeros) {
  var total = array_de_numeros.length;
  var maior = array_de_numeros[0];
  var menor = array_de_numeros[0];
  var soma = 0;
  var pares = 0;
  var impares = 0;

  for (var i = 0; i < array_de_numeros.length; i++) {
    var num = array_de_numeros[i];
    soma = soma + num;

    if (num > maior) {
      maior = num;
    }

    if (num < menor) {
      menor = num;
    }

    if (num % 2 == 0) {
      pares = pares + 1;
    } else {
      impares = impares + 1;
    }
  }

  var media = soma / total;
  var media_arredondada = Math.round(media * 100) / 100;
  return {
    total: total,
    maior: maior,
    menor: menor,
    media: media_arredondada,
    pares: pares,
    impares: impares
  };
}

